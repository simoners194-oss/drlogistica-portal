<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>__UTENTE__</Author>
    <Description>DR Portal: ogni 10 minuti chiede al portale se qualcuno ha premuto "Sincronizza da Aruba" e in quel caso fa il giro completo, senza finestre. Installato con scripts\aruba-prima-nota\trasloco\installa.bat.</Description>
    <URI>\DR Portal - giro su richiesta</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>__UTENTE__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Enabled>true</Enabled>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>__INIZIO__</StartBoundary>
      <Repetition>
        <Interval>PT10M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\wscript.exe</Command>
      <Arguments>//B //Nologo "__CARTELLA__\avvia_nascosto.js" "__CARTELLA__\controlla_giro.bat"</Arguments>
      <WorkingDirectory>__CARTELLA__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
